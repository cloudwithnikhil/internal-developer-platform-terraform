# Terraform working directories and downloaded providers
**/.terraform/*

# Terraform state (may contain sensitive values)
*.tfstate
*.tfstate.*

# Actual variable files
*.tfvars
!*.tfvars.example

# Terraform plans
*.tfplan
*.tfplan.*

# Crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Backup of obsolete network configuration
backup-before-network-redesign/
